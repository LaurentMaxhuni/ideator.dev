# Database and Neon Auth
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-characters

# Public app origin used by auth redirects and provider attribution
NEXT_PUBLIC_APP_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development

# AI providers are attempted in this order when configured: Groq, Workers AI, OpenRouter
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
